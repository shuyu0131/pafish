# 数据库连接（Docker MySQL 8，端口 3307）
DATABASE_URL="mysql://pafish:pafish_pass@127.0.0.1:3307/pafish"

# 会话签名密钥（生产环境务必更换为强随机值）
AUTH_SECRET="pafish-secret-2026-change-me"

# 站点绝对 URL（sitemap/RSS/OG 基准，生产环境改为正式域名）
SITE_URL="http://localhost:3000"

# 邮件 SMTP（可选：后台"站点设置 → 邮件服务"优先，此处仅兜底；验证码/评论通知/测试邮件共用）
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="465"
# SMTP_USER="your-account@qq.com"
# SMTP_PASS="your-smtp-auth-code"
# SMTP_FROM="纸鱼博客 <your-account@qq.com>"

# ---- Docker 部署可选变量（docker compose 读取；手动部署忽略）----
# 宿主机端口冲突时改（服务间走 compose 内网，映射只影响宿主访问）：
# MYSQL_PORT=3308
# APP_PORT=3001
# 国内网络构建加速（npm registry 透传，慢/失败时启用）：
# NPM_REGISTRY=https://registry.npmmirror.com
