// 博客 CMS 数据模型
// MySQL 8 (Docker, 端口 3307)
// 规范：BIGINT UNSIGNED 自增主键、utf8mb4、状态字段用 VARCHAR + 应用层常量

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  username          String    @unique @db.VarChar(50)
  nickname          String?   @db.VarChar(50) // 显示昵称，空则用用户名
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              String    @default("USER") @db.VarChar(20) // ADMIN / EDITOR / USER
  avatarUrl         String?   @map("avatar_url") @db.VarChar(500)
  disabled          Boolean   @default(false) // 禁用后无法登录
  resetToken        String?   @map("reset_token") @db.VarChar(64)
  resetTokenExpires DateTime? @map("reset_token_expires")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  posts    Post[]
  comments Comment[]
  uploads  Upload[]

  @@index([resetToken])
  @@map("users")
}

model Post {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  excerpt     String    @db.VarChar(500)
  content     String    @db.MediumText
  coverUrl    String?   @map("cover_url") @db.VarChar(500)
  status      String    @default("DRAFT") @db.VarChar(20) // DRAFT / PUBLISHED / SCHEDULED
  publishedAt DateTime? @map("published_at")
  viewCount   Int       @default(0) @map("view_count")
  isPinned    Boolean   @default(false) @map("is_pinned")
  categoryPinned Boolean @default(false) @map("category_pinned") // 分类内置顶（emlog 式两级置顶）
  password    String?   @db.VarChar(100) // 访问密码（bcrypt 哈希）
  externalUrl String?   @map("external_url") @db.VarChar(500) // 外链跳转地址
  customFields String?  @map("custom_fields") @db.Text // JSON: [{key, value}]
  likeCount   Int       @default(0) @map("like_count")
  favoriteCount Int     @default(0) @map("favorite_count")
  deletedAt   DateTime? @map("deleted_at") // 非空表示已移入回收站（软删除）
  authorId    BigInt    @map("author_id") @db.UnsignedBigInt
  categoryId  BigInt?   @map("category_id") @db.UnsignedBigInt
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author   User           @relation(fields: [authorId], references: [id])
  category Category?      @relation(fields: [categoryId], references: [id])
  tags     PostTag[]
  comments Comment[]
  notifications Notification[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@map("posts")
}

model Category {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  parentId    BigInt?   @map("parent_id") @db.UnsignedBigInt
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  parent  Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  posts    Post[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Tag {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId BigInt @map("post_id") @db.UnsignedBigInt
  tagId  BigInt @map("tag_id") @db.UnsignedBigInt
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// 独立页面（关于/说明等），可设为站点首页
model Page {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  content     String    @db.MediumText
  status      String    @default("DRAFT") @db.VarChar(20) // DRAFT / PUBLISHED
  template    String    @default("default") @db.VarChar(50) // 页面模板：default / 主题或插件声明的模板名
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("pages")
}

// 友情链接
model Link {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(100)
  url         String   @db.VarChar(500)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("links")
}

// 导航菜单项（前台顶部导航 + 移动端菜单）
model NavItem {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  label      String   @db.VarChar(100)
  url        String   @db.VarChar(500)
  sortOrder  Int      @default(0) @map("sort_order")
  visible    Boolean  @default(true)
  isExternal Boolean  @default(false) @map("is_external") // 外部链接新窗口打开
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sortOrder])
  @@map("nav_items")
}

// 侧边栏组件（前台左栏组件区，可排序/启停；custom 为自定义文本）
model Widget {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  type      String   @db.VarChar(30) // categories / tags / recent_posts / hot_posts / recent_comments / custom
  title     String?  @db.VarChar(100) // 自定义标题，空则用类型默认标题
  content   String?  @db.Text // custom 类型的正文（支持换行与链接）
  sortOrder Int      @default(0) @map("sort_order")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sortOrder])
  @@map("widgets")
}

model Comment {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  postId      BigInt   @map("post_id") @db.UnsignedBigInt
  authorName  String   @map("author_name") @db.VarChar(100)
  authorEmail String   @map("author_email") @db.VarChar(255)
  content     String   @db.Text
  status      String   @default("PENDING") @db.VarChar(20) // PENDING / APPROVED / SPAM / TRASH
  ip          String?  @db.VarChar(45) // 评论者 IP，用于反垃圾与按 IP 管理
  isPinned    Boolean  @default(false) @map("is_pinned")
  parentId    BigInt?  @map("parent_id") @db.UnsignedBigInt
  userId      BigInt?  @map("user_id") @db.UnsignedBigInt
  notifyReply Boolean  @default(false) @map("notify_reply") // 勾选后收到回复时发邮件
  likeCount   Int      @default(0) @map("like_count")
  createdAt   DateTime @default(now()) @map("created_at")

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([postId, status])
  @@index([status, createdAt])
  @@map("comments")
}

model Setting {
  key   String @id @db.VarChar(100)
  value String @db.Text

  @@map("settings")
}

// 邮箱验证码（注册 / 忘记密码）：6 位数字，10 分钟过期，校验通过后标记 used
model EmailCode {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email     String   @db.VarChar(255)
  purpose   String   @db.VarChar(20) // register / reset
  code      String   @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_codes")
}

// 图片文件库：编辑器/封面上传的图片统一入库管理
model Upload {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  originalName String   @map("original_name") @db.VarChar(255) // 原始文件名（不含扩展名）
  url          String   @db.VarChar(500) // 相对 URL，如 /uploads/2026/08/xxx.jpg
  mime         String   @db.VarChar(100)
  size         Int // 压缩后的字节数
  width        Int? // 压缩后宽度（SVG 等无尺寸类型为空）
  height       Int?
  uploaderId   BigInt?  @map("uploader_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at")

  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("uploads")
}

model Notification {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  type      String   @db.VarChar(20) // NEW_COMMENT / NEW_REPLY
  message   String   @db.VarChar(255)
  postId    BigInt?  @map("post_id") @db.UnsignedBigInt
  commentId BigInt?  @map("comment_id") @db.UnsignedBigInt
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}
