{
  "name": "demo-nord",
  "title": "演示·Nord 极夜",
  "version": "1.0.1",
  "description": "Nord 色板主题：北极夜（深）与雪原（浅）双色系。含 color/switcher/radio/image 字段、分组 Tab 与 show_if 依赖演示。",
  "author": "pafish",
  "settings": [
    {
      "key": "footer_text",
      "label": "页脚文案",
      "type": "text",
      "group": "内容",
      "default": "",
      "placeholder": "留空使用默认"
    },
    {
      "key": "logo_image",
      "label": "站点 Logo 图片",
      "type": "image",
      "group": "内容"
    },
    {
      "key": "show_badge",
      "label": "显示侧边栏徽章",
      "type": "switcher",
      "group": "内容",
      "default": "1"
    },
    {
      "key": "badge_text",
      "label": "徽章文字",
      "type": "text",
      "group": "内容",
      "default": "演示主题",
      "show_if": {
        "key": "show_badge",
        "value": "1"
      }
    },
    {
      "key": "layout_style",
      "label": "版式",
      "type": "radio",
      "group": "布局",
      "default": "wide",
      "options": {
        "wide": "宽版",
        "narrow": "窄版"
      }
    },
    {
      "key": "accent_color",
      "label": "强调色",
      "type": "color",
      "group": "布局",
      "default": "#5e81ac"
    },
    {
      "key": "sidebar_enabled",
      "label": "显示桌面侧边栏",
      "type": "switcher",
      "group": "布局",
      "default": "1"
    }
  ],
  "pageTemplates": [
    {
      "name": "wide",
      "title": "宽版页",
      "description": "页面内容区放宽到 1100px（纯 CSS 模板，主题层分发）"
    }
  ]
}
